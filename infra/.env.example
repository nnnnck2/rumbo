# Copiar a infra/.env y completar. .env nunca se sube a Git.

# Dominio público que apunta (registro A) a la IP del VPS (SCRUM-12)
DOMINIO=rumbo.ejemplo.com

# Correo para los avisos de vencimiento de Let's Encrypt
CORREO_LETSENCRYPT=sistemas@ejemplo.com

# 1 = certificado de pruebas de Let's Encrypt (para ensayar sin gastar el límite semanal)
LETSENCRYPT_STAGING=0

# Clave de Redis. Generar con:  openssl rand -base64 32
REDIS_PASSWORD=cambiar-redis-xxxxxxxxxxxxxxxx
