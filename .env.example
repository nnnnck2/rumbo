# Rumbo · variables de entorno de la aplicación (SCRUM-20)
# Copiar a .env y completar. .env NUNCA se sube a Git (está en .gitignore).
# Generar claves:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# ── Django ──────────────────────────────────────────────────────────────────────
# config.settings.dev (local) · config.settings.prod (VPS) · config.settings.test (pruebas)
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: https://visas.empresa.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ── Base de datos (usuario rumbo_app; la clave es RUMBO_APP_PASSWORD de db/.env) ──
DB_NAME=rumbo
DB_USER=rumbo_app
DB_PASSWORD=la-misma-que-RUMBO_APP_PASSWORD-en-db/.env
# Local: 127.0.0.1 (puerto publicado por db/docker-compose.yml). En Docker se fuerza "db".
DB_HOST=127.0.0.1
DB_PORT=5432
# require = TLS obligatorio. Producción con certificado real: verify-full
DB_SSLMODE=require

# ── Redis / Celery ──────────────────────────────────────────────────────────────
# Local: redis://127.0.0.1:6379/0 (en Docker se fuerza redis://redis:6379/0)
REDIS_URL=redis://127.0.0.1:6379/0

# ── WhatsApp Cloud API (Meta for Developers → app → WhatsApp → Configuración) ──
# Token inventado por nosotros; se escribe igual en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=cambiar-token-de-verificacion
# App Secret (Configuración de la app → Básica). Firma de cada POST del webhook.
WHATSAPP_APP_SECRET=cambiar-app-secret-de-meta
# Token de acceso permanente (usuario del sistema). Para enviar mensajes.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Conversions API de Meta (SCRUM-92): citas y ventas de leads de anuncios. Vacías = no se envía nada.
META_DATASET_ID=
META_CAPI_TOKEN=
META_WABA_ID=
META_CAPI_TEST_CODE=
