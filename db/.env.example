# Copiar a .env y reemplazar TODAS las claves (mínimo 16 caracteres, aleatorias).
# Generar una clave:  openssl rand -base64 32
# .env nunca se sube a Git.

POSTGRES_PASSWORD=cambiar-superusuario-xxxxxxxx
RUMBO_MIGRATOR_PASSWORD=cambiar-migrador-xxxxxxxxxx
RUMBO_APP_PASSWORD=cambiar-app-xxxxxxxxxxxxxxx
RUMBO_CALLFLOW_PASSWORD=cambiar-callflow-xxxxxxxxxx
RUMBO_REPLICACION_PASSWORD=cambiar-replicacion-xxxxxxx

# Clave de cifrado de los respaldos. Si se pierde, los respaldos NO se pueden restaurar:
# guárdela también fuera del servidor (gestor de contraseñas del equipo).
PGBACKREST_REPO1_CIPHER_PASS=cambiar-cifrado-respaldos-xxxxxxxxxxxxxxxx

DB_PUERTO=5432
DB_REPLICA_PUERTO=5433

# ── Copia de respaldos FUERA del servidor (repo2) · obligatorio en producción ──
# Al definir PGBACKREST_REPO2_TYPE, desplegar.sh agrega docker-compose.fuera-servidor.yml.
# Ejemplo Backblaze B2 (endpoint y región de la cuenta):
#PGBACKREST_REPO2_TYPE=s3
#PGBACKREST_REPO2_S3_BUCKET=rumbo-respaldos
#PGBACKREST_REPO2_S3_ENDPOINT=s3.us-east-005.backblazeb2.com
#PGBACKREST_REPO2_S3_REGION=us-east-005
#PGBACKREST_REPO2_S3_KEY=keyID-de-la-application-key
#PGBACKREST_REPO2_S3_KEY_SECRET=applicationKey
# Clave de cifrado PROPIA del bucket (distinta de la de repo1). Guardarla fuera del servidor.
#PGBACKREST_REPO2_CIPHER_PASS=cambiar-cifrado-repo2-xxxxxxxxxxxxxxxx
